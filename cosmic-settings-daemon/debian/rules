#!/usr/bin/make -f

export DESTDIR = debian/cosmic-settings-daemon

%:
	dh $@

override_dh_auto_clean:
	@true

override_dh_auto_build:
	if test -e vendor.tar; then \
		just build-vendored; \
	else \
		just build-release; \
	fi

override_dh_auto_test:
	@true

override_dh_auto_install:
	just rootdir=$(DESTDIR) install
