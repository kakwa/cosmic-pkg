From: kakwa <carpentier.pf@gmail.com>
Subject: Use packaged crates for the offline chroot build

The upstream tree pulls a number of dependencies straight from git
(pop-os/cosmic-protocols, pop-os/cosmic-settings,
pop-os/cosmic-settings-daemon, pop-os/cosmic-comp,
pop-os/cosmic-notifications, pop-os/cosmic-osk,
pop-os/dbus-settings-bindings), plus it declares [patch] sections
for the smithay-client-toolkit and cosmic-protocols git forks.

An offline chroot build (cowbuilder/pbuilder with no network access)
cannot fetch any of these git repositories, and the Debian cargo
wrapper additionally replaces the crates.io registry with the
Debian-provided one, so version requirements that only match a git
commit must be relaxed to the versions that are actually packaged.

This patch:
 - removes the [patch."https://github.com/smithay/client-toolkit.git"]
   and [patch."https://github.com/pop-os/cosmic-protocols"] sections,
   since the packaged crates are now used directly
 - switches the workspace and per-crate git dependencies to the
   versions available in the local Debian repository
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -26,12 +26,12 @@
 
 [workspace.dependencies]
 anyhow = "1.0.102"
-cctk = { git = "https://github.com/pop-os/cosmic-protocols", package = "cosmic-client-toolkit", rev = "c0cff4d" }
+cctk = { version = "0.2.0", package = "cosmic-client-toolkit" }
 cosmic-applets-config = { path = "cosmic-applets-config" }
-cosmic-osk-config = { git = "https://github.com/pop-os/cosmic-osk" }
-cosmic-protocols = { git = "https://github.com/pop-os/cosmic-protocols", default-features = false, features = [
+cosmic-osk-config = "1.10"
+cosmic-protocols = { version = "0.2.0", default-features = false, features = [
     "client",
-], rev = "c0cff4d" }
+] }
 
 futures = "0.3"
 futures-util = "0.3"
@@ -40,7 +40,7 @@
     "desktop-requester",
 ] }
 i18n-embed-fl = "0.10"
-libcosmic = { git = "https://github.com/pop-os/libcosmic", default-features = false, features = [
+libcosmic = { version = "1.0.0", default-features = false, features = [
     "applet",
     "applet-token",
     "dbus-config",
@@ -60,7 +60,7 @@
 tracing-log = "0.2.0"
 tokio = { version = "1.49.0", features = ["full"] }
 # cosmic-config = { path = "../libcosmic/cosmic-config" }
-cosmic-config = { git = "https://github.com/pop-os/libcosmic" }
+cosmic-config = "1.0.0"
 serde = { version = "1.0.228", features = ["derive"] }
 zlink = "0.5.0"
 
@@ -80,13 +80,6 @@
 # libcosmic = { git = "https://github.com/pop-os/libcosmic//", branch = "theme-v2" }
 # iced_futures = { git = "https://github.com/pop-os/libcosmic//", branch = "theme-v2" }
 
-[patch."https://github.com/smithay/client-toolkit.git"]
-sctk = { package = "smithay-client-toolkit", version = "0.20.0" }
-
-[patch."https://github.com/pop-os/cosmic-protocols"]
-cosmic-protocols = { git = "https://github.com/pop-os/cosmic-protocols//", rev = "c0cff4d" }
-cosmic-client-toolkit = { git = "https://github.com/pop-os/cosmic-protocols//", rev = "c0cff4d" }
-
 # [patch.'https://github.com/pop-os/dbus-settings-bindings']
 # cosmic-dbus-networkmanager = { path = "../dbus-settings-bindings/networkmanager" }
 # upower_dbus = { path = "../dbus-settings-bindings/upower" }

