#!/usr/bin/make -f

export DESTDIR = debian/tmp

%:
	dh $@

override_dh_auto_clean:
	@true

override_dh_auto_build:
	if test -e vendor.tar; then \
		just disable-if-exists="/cdrom/casper/filesystem.squashfs" build-vendored; \
	else \
		just disable-if-exists="/cdrom/casper/filesystem.squashfs" build-release; \
	fi

override_dh_auto_test:
	@true

override_dh_auto_install:
	just rootdir=$(DESTDIR) install
