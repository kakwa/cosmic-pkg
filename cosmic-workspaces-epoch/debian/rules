#!/usr/bin/make -f

export DESTDIR = debian/cosmic-workspaces

%:
	dh $@

override_dh_auto_clean:
	@true

override_dh_auto_build:
	if test -e vendor.tar; then \
		env CARGO_HOME="$(CURDIR)/target/cargo" $(MAKE) all VENDOR=1 prefix=/usr; \
	else \
		env CARGO_HOME="$(CURDIR)/target/cargo" $(MAKE) all VENDOR=0 prefix=/usr; \
	fi

override_dh_auto_test:
	@true

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/$(DESTDIR) prefix=/usr
