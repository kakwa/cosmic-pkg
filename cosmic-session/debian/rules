#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	cargo build --release

override_dh_auto_install:
	# upstream sed-patches start-cosmic to set DCONF_PROFILE to the absolute
	# profile path; in a .deb the prefix is always /usr
	sed -e 's|DCONF_PROFILE=cosmic|DCONF_PROFILE=/usr/share/dconf/profile/cosmic|' \
	    data/start-cosmic > debian/tmp/usr/bin/start-cosmic
	dh_install
