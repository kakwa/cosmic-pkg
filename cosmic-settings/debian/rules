#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	tar pxf vendor.tar
	env HOME="$(CURDIR)/debian/home" \
		CARGO_HOME="$(CURDIR)/debian/cargo_home" \
		CARGO_NET_OFFLINE=true \
		cargo build --locked --offline --release

override_dh_auto_install:
	env HOME="$(CURDIR)/debian/home" \
		CARGO_HOME="$(CURDIR)/debian/cargo_home" \
		CARGO_NET_OFFLINE=true \
		dh_auto_install
	# Install Rust library crates from the workspace for librust-*-dev packages
	set -e; \
	for spec in "cosmic-settings-a11y-manager-subscription:subscriptions/a11y-manager:librust-cosmic-settings-a11y-manager-subscription-dev" \
	            "cosmic-settings-accessibility-subscription:subscriptions/accessibility:librust-cosmic-settings-accessibility-subscription-dev" \
	            "cosmic-settings-daemon-subscription:subscriptions/settings-daemon:librust-cosmic-settings-daemon-subscription-dev" \
	            "cosmic-settings-upower-subscription:subscriptions/upower:librust-cosmic-settings-upower-subscription-dev"; do \
	  crate=$${spec%%:*}; rest=$${spec#*:}; dir=$${rest%%:*}; pkg=$${rest#*:}; \
	  ver=$$(grep '^version' $$dir/Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/'); \
	  dest=debian/$$pkg/usr/share/cargo/registry/$$crate-$$ver; \
	  mkdir -p $$dest; \
	  cp -a $$dir/. $$dest/; \
	  sed -i \
	    -e 's/^rust-version\.workspace = true$$/rust-version = "1.93"/' \
	    -e 's|cosmic-protocols = { git = "https://github.com/pop-os/cosmic-protocols" }|cosmic-protocols = "0.2.0"|' \
	    -e 's|iced_futures = { git = "https://github.com/pop-os/libcosmic" }|iced_futures = "0.14.0"|' \
	    -e 's|^sctk\.workspace = true$$|sctk = { version = "0.20", package = "smithay-client-toolkit" }|' \
	    -e 's|cosmic-dbus-a11y = { git = "https://github.com/pop-os/dbus-settings-bindings" }|cosmic-dbus-a11y = "0.1.0"|' \
	    -e 's|upower_dbus = { git = "https://github.com/pop-os/dbus-settings-bindings" }|upower_dbus = "0.3.2"|' \
	    $$dest/Cargo.toml; \
	  printf '{"package":null,"files":{}}\n' > $$dest/.cargo-checksum.json; \
	done
