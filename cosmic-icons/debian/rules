#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_clean:
	@true

override_dh_auto_build:
	@true

override_dh_auto_test:
	@true

override_dh_auto_install:
	dh_installdirs -A share/icons/Cosmic
	install -Dm0644 index.theme share/icons/Cosmic/index.theme
	find freedesktop/scalable -type f -exec install -Dm0644 {} share/icons/Cosmic/{} \;
	find extra/scalable -type f -exec install -Dm0644 {} share/icons/Cosmic/{} \;
