#!/usr/bin/make -f

EXTRA_PKG = librust-xdg-shell-wrapper-config-dev
EXTRA_REGISTRY_DIR = debian/$(EXTRA_PKG)/usr/share/cargo/registry/xdg-shell-wrapper-config-1.10.0

%:
	dh $@ --buildsystem cargo

override_dh_auto_clean:
	dh_auto_clean --buildsystem=cargo -N$(EXTRA_PKG)

override_dh_auto_configure:
	dh_auto_configure --buildsystem=cargo -N$(EXTRA_PKG)

override_dh_auto_build:
	dh_auto_build --buildsystem=cargo -N$(EXTRA_PKG)

override_dh_auto_test:
	dh_auto_test --buildsystem=cargo -N$(EXTRA_PKG) -- test --all; true

override_dh_auto_install:
	dh_auto_install --buildsystem=cargo -N$(EXTRA_PKG)
	install -d $(EXTRA_REGISTRY_DIR)
	cp -a xdg-shell-wrapper-config/. $(EXTRA_REGISTRY_DIR)/
	printf '{"package":"unknown","files":{}}\n' > $(EXTRA_REGISTRY_DIR)/.cargo-checksum.json
