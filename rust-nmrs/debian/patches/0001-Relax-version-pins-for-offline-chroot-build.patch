Relax version pins for offline chroot build

nmrs pins exact upstream versions for all of its
dependencies.  The sid chroot only carries slightly
older (or, for base64, an older major) versions of
those crates, so relax every pin to a lower bound
that the packaged sid versions satisfy.  This does
not change the generated code, only which versions
cargo is allowed to resolve to.

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -104,7 +104,7 @@
 
 [dependencies.base64]
-version = "0.23.1"
+version = "0.22"
 
 [dependencies.bitflags]
-version = "2.13.2"
+version = "2"
 
 [dependencies.futures]
-version = "0.3.34"
+version = "0.3"
 
 [dependencies.futures-timer]
-version = "3.0.4"
+version = "3"
 
 [dependencies.log]
-version = "0.4.34"
+version = "0.4"
 
 [dependencies.serde]
-version = "1.0.229"
+version = "1"
 features = ["derive"]
 
 [dependencies.thiserror]
-version = "2.0.21"
+version = "2"
 
 [dependencies.tokio]
-version = "1.53.3"
+version = "1"
 features = [
     "rt-multi-thread",
     "macros",
@@ -137,21 +137,21 @@
 
 [dependencies.uuid]
-version = "1.28.0"
+version = "1"
 features = [
     "v4",
     "v5",
 ]
 
 [dependencies.zbus]
-version = "5.16.0"
+version = "5"
 
 [dependencies.zvariant]
-version = "5.15.0"
+version = "5"
 
 [dev-dependencies.serial_test]
-version = "4.0.1"
+version = "4"
 
 [dev-dependencies.zbus]
-version = "5.16.0"
+version = "5"
 features = ["p2p"]
