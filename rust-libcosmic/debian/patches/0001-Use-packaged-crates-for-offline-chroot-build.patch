Description: Use packaged crates for offline chroot build
 The libcosmic crate is built from the full git repo. This patch
 de-gits and de-workspaces all dependencies so the crate can be
 built offline using only packaged (Debian) dependencies.

Author: Debian Rust Maintainers
Last-Update: 2026-11-16
---
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -121,15 +121,15 @@
 [dependencies]
 apply = "0.3.0"
 async-fs = { version = "2.2", optional = true }
-async-std = { workspace = true, optional = true }
+async-std = "1.13"
 auto_enums = "0.8.8"
 jiff = "0.2"
-cosmic-config = { path = "cosmic-config" }
-cosmic-settings-config = { git = "https://github.com/pop-os/cosmic-settings-daemon", optional = true }
+cosmic-config = { version = "1.0.0" }
+cosmic-settings-config = { version = "1.10.0", optional = true }
 # Internationalization
 i18n-embed = { version = "0.16.0", features = [
-    "fluent-system",
-    "desktop-requester",
+"fluent-system",
+"desktop-requester",
 ] }
 i18n-embed-fl = "0.10"
 rust-embed = "8.11.0"
@@ -137,47 +137,47 @@
