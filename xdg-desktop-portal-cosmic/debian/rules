#!/usr/bin/make -f

export DESTDIR = debian/xdg-desktop-portal-cosmic

%:
	dh $@

override_dh_auto_clean:
	@true

override_dh_auto_build:
	if test -e vendor.tar; then \
		just vendor=1 build; \
	else \
		just build; \
	fi

override_dh_auto_test:
	@true

override_dh_auto_install:
	just rootdir=$(DESTDIR) install
