Description: Use packaged crates for offline chroot build
 The cosmic-config crate is extracted from the full libcosmic git
 repository. This patch de-gits and de-workspaces its dependencies so it
 can be built offline using only packaged (Debian) dependencies, and
 points the cosmic-config-derive path dependency at the co-packaged
 copy.

Author: Debian Rust Maintainers
Last-Update: 2026-11-17
---
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -10,19 +10,19 @@

 [dependencies]
-cosmic-settings-daemon = { git = "https://github.com/pop-os/dbus-settings-bindings", optional = true }
-zbus = { workspace = true, default-features = false, optional = true }
-atomicwrites = { git = "https://github.com/jackpot51/rust-atomicwrites" }
+cosmic-settings-daemon = { version = "0.1.0", optional = true }
+zbus = { version = "5.15", default-features = false, optional = true }
+atomicwrites = { version = "0.4.4" }
 calloop = { version = "0.14.4", optional = true }
 notify = "8.2.0"
-ron.workspace = true
-serde.workspace = true
-cosmic-config-derive = { path = "../cosmic-config-derive/", optional = true }
-iced = { path = "../iced/", default-features = false, optional = true }
-iced_futures = { path = "../iced/futures/", default-features = false, optional = true }
+ron = "0.12"
+serde = { version = "1.0" }
+cosmic-config-derive = { path = "./cosmic-config-derive/", optional = true }
+iced = { version = "0.14.0", default-features = false, optional = true }
+iced_futures = { version = "0.14.0", default-features = false, optional = true }
 futures-util = { version = "0.3", optional = true }
-dirs.workspace = true
-tokio = { workspace = true, optional = true, features = ["time"] }
-async-std = { workspace = true, optional = true }
-tracing.workspace = true
+dirs = "6.0"
+tokio = { version = "1.52", optional = true, features = ["time"] }
+async-std = { version = "1.13", optional = true }
+tracing = "0.1"

 [target.'cfg(unix)'.dependencies]
 xdg = "3.0"
